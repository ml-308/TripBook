<Window x:Class="TripBook.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建行程" Height="790" Width="860" MinHeight="620" MinWidth="720"
        Background="#0D1015" Foreground="#E9EFF8"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        WindowStartupLocation="CenterOwner" Icon="icon.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        SourceInitialized="Window_SourceInitialized">

    <Grid Margin="22,20,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" x:Name="HeaderText" Text="新建行程"
                   FontSize="17" FontWeight="Bold" Foreground="#E9EFF8"/>

        <!-- 日期 / 标题 -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="日期" Foreground="#9AA5B8" VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="DateBox" Width="128" Style="{StaticResource Input}"
                     TextChanged="DateBox_TextChanged"/>
            <TextBlock Grid.Column="2" Text="标题" Foreground="#9AA5B8" VerticalAlignment="Center"
                       Margin="18,0,8,0"/>
            <TextBox Grid.Column="3" x:Name="TitleBox" Style="{StaticResource Input}"
                     TextChanged="TitleBox_TextChanged"/>
        </Grid>

        <!-- 文本区标题 -->
        <Grid Grid.Row="2" Margin="0,18,0,8">
            <TextBlock Text="行程文本" FontSize="12" FontWeight="Bold" Foreground="#9AA5B8"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="从剪贴板粘贴" Style="{StaticResource BtnGhost}" Click="Paste_Click"/>
                <Button Content="填入示例" Style="{StaticResource BtnGhost}" Margin="4,0,0,0"
                        Click="Sample_Click"/>
            </StackPanel>
        </Grid>

        <!-- 编辑器 -->
        <TextBox Grid.Row="3" x:Name="Editor" Style="{StaticResource EditorBox}"
                 TextChanged="Editor_TextChanged" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"/>

        <!-- 识别状态 -->
        <TextBlock Grid.Row="4" x:Name="StatusText" Text="等待输入…" Foreground="#66707F"
                   FontSize="12" Margin="2,10,0,0"/>

        <!-- 预览 -->
        <Border Grid.Row="5" x:Name="PreviewPanel" Style="{StaticResource Card}" Padding="12,10"
                Margin="0,10,0,0" Visibility="Collapsed">
            <StackPanel x:Name="PreviewStack"/>
        </Border>

        <!-- 底部 -->
        <Separator Grid.Row="6" Margin="0,16,0,0"/>
        <Grid Grid.Row="7" Margin="0,14,0,0">
            <TextBlock Text="Ctrl+S 保存 · Ctrl+Enter 保存 · Esc 取消" Foreground="#5E6779"
                       FontSize="11" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource Btn}" Height="34" Width="86"
                        Click="Cancel_Click" IsCancel="True"/>
                <Button Content="保存行程" Style="{StaticResource BtnPrimary}" Height="34" Width="112"
                        Margin="10,0,0,0" Click="Save_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
