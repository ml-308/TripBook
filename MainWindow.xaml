<Window x:Class="TripBook.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TripBook"
        Title="行程簿 TripBook"
        Height="830" Width="1260" MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#0D1015" Foreground="#E9EFF8"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Icon="icon.ico"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Loaded="Window_Loaded" Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <local:LineBrushConverter x:Key="LineBrush"/>
        <local:NotEmptyVisConverter x:Key="NotEmptyVis"/>
        <local:NotNullVisConverter x:Key="NotNullVis"/>
        <local:BoolVisConverter x:Key="BoolVis"/>

        <!-- 普通乘降事件 -->
        <DataTemplate x:Key="EntryTpl">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,10,6,0">
                    <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="13"
                               FontWeight="Bold" Foreground="{Binding DotBrush}"
                               HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding DayMark}" FontSize="9" Foreground="#66707F"
                               HorizontalAlignment="Right" Margin="0,1,0,0"
                               Visibility="{Binding HasDayMark, Converter={StaticResource BoolVis}}"/>
                </StackPanel>

                <Grid Grid.Column="1">
                    <Rectangle Width="2" Fill="#28313F" HorizontalAlignment="Center"
                               VerticalAlignment="Top" Height="22" Margin="0,-8,0,0"
                               Visibility="{Binding ShowRailTop, Converter={StaticResource BoolVis}}"/>
                    <Rectangle Width="2" Fill="#28313F" HorizontalAlignment="Center"
                               VerticalAlignment="Stretch" Margin="0,22,0,-8"
                               Visibility="{Binding ShowRailBottom, Converter={StaticResource BoolVis}}"/>
                    <Ellipse Width="9" Height="9" Fill="{Binding DotBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Top"
                             Margin="0,18,0,0"/>
                </Grid>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,11,14,12"
                        Background="#1A212C">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <WrapPanel Grid.Column="0">
                                <Border Style="{StaticResource PillBorder}"
                                        Background="{Binding ActionBg}"
                                        BorderBrush="{Binding ActionBorder}"
                                        Margin="0,0,6,0" Padding="8,2"
                                        Visibility="{Binding HasAction, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{Binding Action}"
                                               Foreground="{Binding ActionFg}"
                                               FontSize="11" FontWeight="Bold"/>
                                </Border>
                                <Border Style="{StaticResource PillBorder}"
                                        Background="{Binding LineBg}"
                                        BorderBrush="{Binding LineBorder}"
                                        Margin="0,0,6,0" Padding="9,2"
                                        Visibility="{Binding HasLine, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{Binding Line}"
                                               Foreground="{Binding LineFg}"
                                               FontSize="12" FontWeight="Bold"/>
                                </Border>
                                <Border Style="{StaticResource PillBorder}"
                                        Background="#14FFFFFF" BorderBrush="#1AFFFFFF"
                                        Margin="0,0,6,0" Padding="8,2"
                                        Visibility="{Binding HasVehicle, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{Binding VehicleText}"
                                               Foreground="#9AA5B8" FontSize="11"
                                               FontFamily="Consolas"/>
                                </Border>
                            </WrapPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Fare}"
                                       Foreground="{Binding FareBrush}"
                                       FontFamily="Consolas" FontSize="13"
                                       FontWeight="SemiBold" VerticalAlignment="Top"
                                       Margin="8,2,0,0"
                                       Visibility="{Binding HasFare, Converter={StaticResource BoolVis}}"/>
                        </Grid>
                        <TextBlock Text="{Binding Station}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="#E9EFF8" Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding Station, Converter={StaticResource NotEmptyVis}}"/>
                        <TextBlock Text="{Binding Note}" FontSize="12" Foreground="#9AA5B8"
                                   Margin="0,5,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasNote, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- 时间标记行（如：刷新换乘优惠） -->
        <DataTemplate x:Key="MarkerTpl">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Time}" FontFamily="Consolas" FontSize="11"
                           Foreground="#5E6779" HorizontalAlignment="Right" Margin="0,2,6,0"/>
                <Rectangle Grid.Column="1" Width="2" Height="2" Fill="#3A4658" RadiusX="1" RadiusY="1"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Border Grid.Column="2" Background="#151A22" BorderBrush="#222B38" BorderThickness="1"
                        CornerRadius="8" Padding="12,6" Margin="0,1,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="◇" Foreground="#5E6779" FontSize="11" Margin="0,0,7,0"/>
                        <TextBlock Text="{Binding MarkerText}" FontSize="12" Foreground="#7E8896"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <local:TimelineSelector x:Key="TimelineSelector"
                                EntryTemplate="{StaticResource EntryTpl}"
                                MarkerTemplate="{StaticResource MarkerTpl}"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="296"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= 侧边栏 ================= -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,1,0">
            <Grid Margin="14,14,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 品牌 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="11">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4C8DFF" Offset="0"/>
                                <GradientStop Color="#7B5BFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="行" Foreground="White" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="行程簿" Style="{StaticResource AppTitle}"/>
                        <TextBlock Text="TRIPBOOK" Style="{StaticResource AppSub}" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 搜索 -->
                <Grid Grid.Row="1" Margin="0,10,0,8">
                    <TextBox x:Name="SearchBox" Style="{StaticResource Input}"
                             TextChanged="SearchBox_TextChanged"/>
                    <TextBlock x:Name="SearchHint" Text="搜索站点 / 线路 / 日期"
                               Foreground="#5E6779" Margin="12,0,0,0" FontSize="12"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>

                <!-- 行程列表 -->
                <ListBox Grid.Row="2" x:Name="JourneyList" Style="{StaticResource JourneyList}"
                         SelectionMode="Extended"
                         PreviewMouseDown="JourneyList_PreviewMouseDown"
                         PreviewKeyDown="JourneyList_PreviewKeyDown"
                         SelectionChanged="JourneyList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="42" Height="44" CornerRadius="8"
                                        Background="#222B38" VerticalAlignment="Center">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Day}" FontFamily="Consolas" FontSize="16"
                                                   FontWeight="Bold" HorizontalAlignment="Center"
                                                   Foreground="#E9EFF8"/>
                                        <TextBlock Text="{Binding Month}" FontSize="9"
                                                   HorizontalAlignment="Center" Foreground="#66707F"
                                                   Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#E9EFF8" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="#66707F"
                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 底部 -->
                <StackPanel Grid.Row="3">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="概览" Style="{StaticResource BtnGhost}"
                                Click="Overview_Click"/>
                        <Button Grid.Column="2" Content="导入" ToolTip="批量导入 TXT 行程文本"
                                Style="{StaticResource BtnGhost}" Click="Import_Click"/>
                        <Button x:Name="BatchButton" Grid.Column="4" Content="批量"
                                ToolTip="批量删除 / 批量修改行程年份" Style="{StaticResource BtnGhost}"
                                Click="Batch_Click"/>
                    </Grid>
                    <TextBlock x:Name="CountLabel" Text="暂无数据" Style="{StaticResource Dim}"
                               Margin="2,0,0,6"/>
                    <Button x:Name="NewButton" Content="＋  新建行程" Style="{StaticResource BtnPrimary}"
                            Height="34" Click="New_Click"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="数据目录" Style="{StaticResource BtnGhost}"
                                HorizontalAlignment="Left" Click="DataDir_Click"/>
                        <Button Grid.Column="1" Content="⋯" Style="{StaticResource BtnGhost}" Width="34"
                                Click="DataDir_Click"/>
                    </Grid>
                    <TextBlock x:Name="DirLabel" Style="{StaticResource Dim}" FontSize="10"
                               TextTrimming="CharacterEllipsis" Margin="2,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 右侧内容 ================= -->
        <Grid Grid.Column="1">
            <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Margin="30,26,30,40" MaxWidth="1040" HorizontalAlignment="Left">
                    <!-- 头部 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Kicker}" Style="{StaticResource Dim}"/>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" Margin="0,6,0,0"/>
                            <ItemsControl ItemsSource="{Binding Chips}" Margin="0,12,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource PillBorder}" Background="{Binding Bg}"
                                                BorderBrush="{Binding Border}" Margin="0,0,6,4" Padding="9,3">
                                            <TextBlock Text="{Binding Text}" Foreground="{Binding Fg}"
                                                       FontSize="{Binding FontSize}" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="编辑" Style="{StaticResource BtnPrimary}" Click="Edit_Click"/>
                            <Button Content="导出网页" Style="{StaticResource Btn}" Margin="8,0,0,0"
                                    Click="Export_Click"/>
                            <Button Content="⋯" Style="{StaticResource Btn}" Width="38" Margin="8,0,0,0"
                                    Click="More_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 统计卡 -->
                    <ItemsControl ItemsSource="{Binding Stats}" Margin="0,20,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Value}" FontFamily="Consolas" FontSize="21"
                                                   FontWeight="Bold" Foreground="{Binding Accent}"/>
                                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#66707F"
                                                   Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding Hint}" FontSize="11" Foreground="#4E5765"
                                                   Margin="0,1,0,0"
                                                   Visibility="{Binding HasHint, Converter={StaticResource BoolVis}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 线路接力 -->
                    <StackPanel Visibility="{Binding HasChain, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="线路接力" Style="{StaticResource SectionTitle}" Margin="2,22,0,10"/>
                        <Border Style="{StaticResource Card}" Padding="16">
                            <ItemsControl ItemsSource="{Binding Chain}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Border BorderBrush="{Binding Border}" BorderThickness="1"
                                                    CornerRadius="10" Background="{Binding Bg}"
                                                    Padding="12,7" Margin="0,0,8,0"
                                                    Visibility="{Binding IsArrow, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Line}" Foreground="{Binding Fg}"
                                                               FontWeight="Bold" FontSize="13"/>
                                                    <TextBlock Text="{Binding VehicleText}" FontSize="10"
                                                               Foreground="#66707F" Margin="0,2,0,0"
                                                               Visibility="{Binding HasVehicle, Converter={StaticResource BoolVis}}"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="→" Foreground="#3A4658" FontSize="13"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       Visibility="{Binding IsArrow, Converter={StaticResource BoolVis}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <!-- 时间轴 -->
                    <TextBlock Text="行程时间轴" Style="{StaticResource SectionTitle}" Margin="2,22,0,10"/>
                    <ItemsControl ItemsSource="{Binding Entries}"
                                  ItemTemplateSelector="{StaticResource TimelineSelector}"/>

                    <!-- POV 总结（单条行程） -->
                    <StackPanel>
                        <TextBlock Text="POV 总结" Style="{StaticResource SectionTitle}" Margin="2,22,0,4"/>
                        <TextBlock Text="{Binding PovSubtitle}" Style="{StaticResource Dim}" Margin="2,0,0,10"/>
                        <UniformGrid Rows="1" Columns="4" Margin="0,0,0,12"
                                     Visibility="{Binding HasPov, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding PovSegmentCount}" FontFamily="Consolas" FontSize="19"
                                           FontWeight="Bold" Foreground="#A98BFF"/>
                                <TextBlock Text="POV 片段" FontSize="11" Foreground="#66707F" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding PovLineCount}" FontFamily="Consolas" FontSize="19"
                                           FontWeight="Bold" Foreground="#4C8DFF"/>
                                <TextBlock Text="涉及线路" FontSize="11" Foreground="#66707F" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding PovVehicleCount}" FontFamily="Consolas" FontSize="19"
                                           FontWeight="Bold" Foreground="#36C9A0"/>
                                <TextBlock Text="涉及车号" FontSize="11" Foreground="#66707F" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding PovTagCount}" FontFamily="Consolas" FontSize="19"
                                           FontWeight="Bold" Foreground="#F0B35B"/>
                                <TextBlock Text="机位标签" FontSize="11" Foreground="#66707F" Margin="0,2,0,0"/>
                            </StackPanel>
                        </UniformGrid>
                        <ItemsControl ItemsSource="{Binding Pov}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="14,11" Margin="0,0,0,8">
                                        <StackPanel>
                                            <WrapPanel>
                                                <Border Background="#26A98BFF" BorderBrush="#55A98BFF"
                                                        BorderThickness="1" CornerRadius="6" Padding="7,1"
                                                        Margin="0,0,8,0"
                                                        Visibility="{Binding HasTag, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="{Binding Tag}" Foreground="#A98BFF"
                                                               FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text="{Binding Line}" Foreground="{Binding LineFg}"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Vehicle}" FontFamily="Consolas"
                                                           FontSize="12" Foreground="#66707F"
                                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                                           Visibility="{Binding HasVehicle, Converter={StaticResource BoolVis}}"/>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding Segment}" FontSize="12"
                                                       Foreground="#9AA5B8" Margin="0,5,0,0"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding HasSegment, Converter={StaticResource BoolVis}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="还没有 POV 片段记录" FontSize="12" Foreground="#66707F" Margin="0,2,0,0"
                                   Visibility="{Binding HasPov, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
                    </StackPanel>

                    <!-- 备注 -->
                    <StackPanel Visibility="{Binding HasNotes, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="备注" Style="{StaticResource SectionTitle}" Margin="2,18,0,10"/>
                        <Border Style="{StaticResource Card}" Padding="16,12">
                            <ItemsControl ItemsSource="{Binding Notes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="#9AA5B8"
                                                   TextWrapping="Wrap" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 总览 -->
            <ScrollViewer x:Name="DashScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Margin="30,26,30,40" MaxWidth="1040" HorizontalAlignment="Left">
                    <TextBlock Text="行程总览" Style="{StaticResource H1}"/>
                    <TextBlock Text="{Binding DateRange}" Style="{StaticResource Dim}" Margin="0,6,0,0"/>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="{Binding JourneyCount}" FontFamily="Consolas" FontSize="21"
                                           FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="行程总数" FontSize="11" Foreground="#66707F" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="{Binding RecordCount}" FontFamily="Consolas" FontSize="21"
                                           FontWeight="Bold" Foreground="{StaticResource TealBrush}"/>
                                <TextBlock Text="乘降记录" FontSize="11" Foreground="#66707F" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource Card}" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Bars.Count}" FontFamily="Consolas" FontSize="21"
                                           FontWeight="Bold" Foreground="{StaticResource AmberBrush}"/>
                                <TextBlock Text="有记录的日期" FontSize="11" Foreground="#66707F" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="行程日期分布" Style="{StaticResource SectionTitle}" Margin="2,22,0,10"/>
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Bars}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Date}" FontFamily="Consolas"
                                                       FontSize="11" Foreground="#9AA5B8" VerticalAlignment="Center"/>
                                            <Rectangle Grid.Column="1" Height="14" RadiusX="4" RadiusY="4"
                                                       HorizontalAlignment="Left" Width="{Binding BarWidth}"
                                                       Fill="{Binding Brush}" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="11"
                                                       Foreground="#66707F" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="还没有任何记录" FontSize="12" Foreground="#66707F"
                                       Visibility="{Binding HasBars, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
                        </StackPanel>
                    </Border>

                    <!-- POV 总结 -->
                    <TextBlock Text="POV 总结" Style="{StaticResource SectionTitle}" Margin="2,22,0,4"/>
                    <TextBlock Text="{Binding Pov.Subtitle}" Style="{StaticResource Dim}" Margin="2,0,0,10"/>
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,14"
                                         Visibility="{Binding Pov.HasRows, Converter={StaticResource BoolVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Pov.SegmentCount}" FontFamily="Consolas" FontSize="19"
                                               FontWeight="Bold" Foreground="#A98BFF"/>
                                    <TextBlock Text="POV 片段" FontSize="11" Foreground="#66707F" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding Pov.JourneyCount}" FontFamily="Consolas" FontSize="19"
                                               FontWeight="Bold" Foreground="#4C8DFF"/>
                                    <TextBlock Text="覆盖行程" FontSize="11" Foreground="#66707F" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding Pov.LineCount}" FontFamily="Consolas" FontSize="19"
                                               FontWeight="Bold" Foreground="#36C9A0"/>
                                    <TextBlock Text="涉及线路" FontSize="11" Foreground="#66707F" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding Pov.VehicleCount}" FontFamily="Consolas" FontSize="19"
                                               FontWeight="Bold" Foreground="#F0B35B"/>
                                    <TextBlock Text="涉及车号" FontSize="11" Foreground="#66707F" Margin="0,2,0,0"/>
                                </StackPanel>
                            </UniformGrid>

                            <ItemsControl ItemsSource="{Binding Pov.Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#151A22" BorderBrush="#222B38" BorderThickness="1"
                                                CornerRadius="9" Padding="12,9" Margin="0,0,0,7">
                                            <WrapPanel>
                                                <TextBlock Text="{Binding Date}" FontFamily="Consolas" FontSize="11"
                                                           Foreground="#66707F" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding JourneyTitle}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="#9AA5B8" VerticalAlignment="Center" Margin="0,0,10,0"
                                                           MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                                                <Border CornerRadius="6" Padding="8,2" Margin="0,0,8,0"
                                                        Background="#264C8DFF" BorderBrush="#554C8DFF" BorderThickness="1">
                                                    <TextBlock Text="{Binding Line}" Foreground="{Binding LineFg}"
                                                               FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding Segment}" FontSize="12" Foreground="#9AA5B8"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                                           Visibility="{Binding HasSegment, Converter={StaticResource BoolVis}}"/>
                                                <TextBlock Text="{Binding Vehicle}" FontFamily="Consolas" FontSize="11"
                                                           Foreground="#66707F" VerticalAlignment="Center" Margin="0,0,8,0"
                                                           Visibility="{Binding HasVehicle, Converter={StaticResource BoolVis}}"/>
                                                <Border CornerRadius="6" Padding="7,1" Margin="0,0,4,0"
                                                        Background="#26A98BFF" BorderBrush="#55A98BFF" BorderThickness="1"
                                                        Visibility="{Binding HasTag, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="{Binding Tag}" Foreground="#A98BFF"
                                                               FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </WrapPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="还没有 POV 片段记录" FontSize="12" Foreground="#66707F"
                                       Visibility="{Binding Pov.HasRows, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 空状态 -->
            <Grid x:Name="EmptyPanel">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="🚌" FontSize="54" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyTitle" Text="还没有行程记录" Style="{StaticResource H1}"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    <TextBlock x:Name="EmptySub" Text="粘贴随手记的行程文本，自动整理成时间轴、线路链与统计"
                               Foreground="#9AA5B8" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                        <Button Content="新建行程" Style="{StaticResource BtnPrimary}" Height="38" Width="120"
                                Click="New_Click"/>
                        <Button Content="载入示例数据" Style="{StaticResource Btn}" Height="38" Margin="10,0,0,0"
                                Click="Sample_Click"/>
                    </StackPanel>
                    <TextBlock Text="数据保存在本机，可随时更换目录 · Ctrl+N 新建"
                               Foreground="#4E5765" FontSize="11" HorizontalAlignment="Center"
                               Margin="0,18,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 提示条 -->
            <Border x:Name="Toast" Visibility="Collapsed" HorizontalAlignment="Center"
                    VerticalAlignment="Bottom" Margin="0,0,0,26"
                    Background="#20293A" BorderBrush="#334054" BorderThickness="1"
                    CornerRadius="8" Padding="16,8" IsHitTestVisible="False">
                <TextBlock x:Name="ToastText" Text="" Foreground="#E9EFF8" FontSize="12"/>
            </Border>
        </Grid>
    </Grid>
</Window>
